{
  "name": "kayzen-flux",
  "private": true,
  "version": "1.0.0",
  "description": "KAYZEN Flux — téléchargeur et convertisseur multimédia local-first (moteur yt-dlp)",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "start": "node apps/daemon/dist/server.js",
    "dev": "pnpm --parallel -r dev",
    "dist:linux": "pnpm --filter @kayzen-flux/ui build && pnpm --filter @kayzen-flux/desktop dist:linux",
    "license": "node tools/license.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "overrides": {
      "tar": "^7.5.23",
      "glob@>=9 <14.0.2": "^14.0.2",
      "minimatch@>=7 <11.0.1": "^11.0.1",
      "electron-builder-squirrel-windows": "26.18.0",
      "dmg-builder": "26.18.0"
    }
  }
}
