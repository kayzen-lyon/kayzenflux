{
  "name": "@kayzen-flux/daemon",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": { "@kayzen-flux/core": "workspace:*" },
  "devDependencies": { "@types/node": "^22.10.0", "esbuild": "^0.24.2", "tsx": "^4.19.2", "typescript": "^5.7.3", "vitest": "^3.0.5" }
}
